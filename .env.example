# Copy to .env and customize for your local environment
POSTGRES_USER=hackatonxp
POSTGRES_PASSWORD=hackatonxp_pass
POSTGRES_DB=hackatonxp_db
POSTGRES_PORT=5432

# Connection string used by the API. If provided, the API will use PostgreSQL.
# Example: Host=localhost;Port=5432;Database=hackatonxp_db;Username=hackatonxp;Password=hackatonxp_pass
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=hackatonxp_db;Username=hackatonxp;Password=hackatonxp_pass

# For development only: set to "true" to allow InMemory provider without PostgreSQL.
# Use only when you understand that persistence will be ephemeral.
HACKATONXP_ALLOW_INMEMORY=false
